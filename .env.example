# Copy to .env in the repo root. Used by Docker Compose.
# APP_ENV=development creates DB tables on startup (fine for local use).

APP_ENV=development

# Postgres (Docker Compose)
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass
POSTGRES_DB=finance_app

# Backend
DATABASE_URL=postgresql+psycopg://finance_user:finance_pass@localhost:5432/finance_app
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated allowed frontend origins (local development uses HTTP)
CORS_ORIGINS=http://localhost:3000

# Login cookies. Secure=false is OK for local HTTP. Leave COOKIE_DOMAIN empty locally.
ACCESS_TOKEN_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=

# AI (backend only). Set AI_ENABLED=true and GEMINI_API_KEY to try insights locally.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.0-flash
GEMINI_API_KEY=

# Backend tests (optional — defaults to finance_app_test on localhost)
# TEST_DATABASE_URL=postgresql+psycopg://finance_user:finance_pass@localhost:5432/finance_app_test

# URL the browser uses to call the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production template: see .env.production.example
